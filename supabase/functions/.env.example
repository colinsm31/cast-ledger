# Secrets for the Edge Functions when run locally (`supabase functions serve`).
# Copy to supabase/functions/.env (gitignored) and fill in; never commit the
# real values. Hosted projects set the same names under Edge Functions → Secrets.
#
# send-notifications (Phase 3E). Leave the first two empty for test mode:
# messages are logged as "not sent" and nothing leaves.
RESEND_API_KEY=
# "Shop Name <service@yourshop.com>", on a domain verified in Resend
NOTIFY_FROM_EMAIL=
# Optional: where customers' replies go
NOTIFY_REPLY_TO=
